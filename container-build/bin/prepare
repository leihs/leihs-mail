#!/usr/bin/env bash
set -euo pipefail
set -x

apt update --yes
apt dist-upgrade --yes

# build dependencies for the tools mise installs from source (ruby via
# ruby-build) plus what java/clojure need; Debian trixie package names
apt install --yes \
  autoconf \
  bison \
  build-essential \
  ca-certificates \
  curl \
  git \
  gpg \
  libdb-dev \
  libffi-dev \
  libgdbm-dev \
  libgmp-dev \
  libncurses-dev \
  libpq-dev \
  libreadline-dev \
  libssl-dev \
  libyaml-dev \
  patch \
  rlwrap \
  rustc \
  shared-mime-info \
  unzip \
  uuid-dev \
  zlib1g-dev

# vi: ft=sh
